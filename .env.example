# ============================================================
# .env.example — Mappa Concettuale 3 Passi
# ============================================================
#
# COPIA questo file in `.env` e valorizza le variabili SOLO se
# servono. L'attività didattica (3 passi + canvas + PDF/PNG) è
# interamente lato client e NON richiede nessuna di queste
# variabili: su Render l'app funziona anche senza database.
#
# In produzione Easy-Peasy.AI queste variabili vengono iniettate
# automaticamente dal sandbox/piattaforma.
#
# ============================================================

# --- Ambiente ---
# NODE_ENV=production viene già impostato da `pnpm start`.
NODE_ENV=production

# --- Porta del server Express (opzionale, default: 3000) ---
# Su Render/Cloud Run la porta è iniettata automaticamente (PORT).
PORT=3000

# --- Database PostgreSQL (OPZIONALE — serve solo all'auth dello scaffold) ---
# Per attivare Better Auth (pagina /login) imposta un PostgreSQL
# (es. Render Postgres, Neon) e poi esegui: pnpm db:push
DATABASE_URL=

# --- Better Auth - Session encryption secret (opzionale) ---
# Serve solo se attivi l'auth. Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Better Auth - Trusted origins per CORS/cookie (opzionale) ---
# Es. https://mappa-concettuale-3-passi.onrender.com (dominio Render)
TRUSTED_ORIGINS=

# --- OAuth providers (opzionali, lasciare vuoti per disabilitare) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Storage file upload (OPZIONALE — NON usato dal flusso studente) ---
# Il flusso studente carica le immagini come dataURL locali.
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=
# STORAGE_PUBLIC_URL=
# STORAGE_KEY_PREFIX=
